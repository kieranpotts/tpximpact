{#
  The home page: the shorten form, the short URL just created or deleted, if
  any, and the table of every short URL. `shortUrls` is undefined when they
  couldn't be loaded.
#}
{% extends "layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% set title = "Shorten a URL" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errors.summary
        }) }}
      {% endif %}

      {% if created %}
        {% set createdHtml %}
          <h3 class="govuk-notification-banner__heading">Your short URL is ready</h3>
          <p class="govuk-body govuk-!-text-break-word">
            <a class="govuk-notification-banner__link" href="{{ created.shortUrl }}">{{ created.shortUrl }}</a>
          </p>
          <p class="govuk-body govuk-!-text-break-word">It redirects to {{ created.destinationUrl }}</p>
        {% endset %}
        {{ govukNotificationBanner({
          type: "success",
          html: createdHtml
        }) }}
      {% endif %}

      {% if deleted %}
        {% set deletedHtml %}
          <h3 class="govuk-notification-banner__heading govuk-!-text-break-word">The short URL {{ deleted }} was deleted</h3>
        {% endset %}
        {{ govukNotificationBanner({
          type: "success",
          html: deletedHtml
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">{{ title }}</h1>

      <form method="post" action="/links" novalidate>
        {{ govukInput({
          label: { text: "Destination URL" },
          hint: { text: "The long URL to shorten, for example https://example.com/very/long/url" },
          id: "destinationUrl",
          name: "destinationUrl",
          type: "url",
          value: form.destinationUrl,
          spellcheck: false,
          autocomplete: "url",
          errorMessage: { text: errors.fields.destinationUrl } if errors and errors.fields.destinationUrl
        }) }}

        {{ govukInput({
          label: { text: "Custom alias (optional)" },
          hint: { text: "Leave this empty to get a random alias." },
          id: "customAlias",
          name: "customAlias",
          value: form.customAlias,
          classes: "govuk-!-width-one-half",
          spellcheck: false,
          autocomplete: "off",
          errorMessage: { text: errors.fields.customAlias } if errors and errors.fields.customAlias
        }) }}

        {{ govukButton({
          text: "Shorten URL",
          preventDoubleClick: true
        }) }}
      </form>
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m" id="short-urls">All short URLs</h2>

      {% if shortUrls is undefined %}
        <p class="govuk-body">The short URLs could not be loaded. Try again later.</p>
      {% elif shortUrls | length == 0 %}
        <p class="govuk-body">There are no short URLs yet.</p>
      {% else %}
        <table class="govuk-table" aria-labelledby="short-urls">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Alias</th>
              <th scope="col" class="govuk-table__header">Short URL</th>
              <th scope="col" class="govuk-table__header">Destination URL</th>
              <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for shortUrl in shortUrls %}
              {% set deleteHtml %}Delete<span class="govuk-visually-hidden"> {{ shortUrl.alias }}</span>{% endset %}
              <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header govuk-!-text-break-word">{{ shortUrl.alias }}</th>
                <td class="govuk-table__cell govuk-!-text-break-word">
                  <a class="govuk-link" href="{{ shortUrl.shortUrl }}">{{ shortUrl.shortUrl }}</a>
                </td>
                <td class="govuk-table__cell govuk-!-text-break-word">{{ shortUrl.destinationUrl }}</td>
                <td class="govuk-table__cell">
                  <form method="post" action="/links/{{ shortUrl.alias | urlencode }}/delete">
                    {{ govukButton({
                      html: deleteHtml,
                      classes: "govuk-button--warning govuk-!-margin-bottom-0",
                      preventDoubleClick: true
                    }) }}
                  </form>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
  </div>
{% endblock %}
