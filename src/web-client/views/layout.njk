{#
  The page layout, on GOV.UK Frontend's template. The template's header and
  footer show the crown, which only government services may use, so they're
  replaced. See: docs > decisions > 0008.

  Pages set `title`, and `errors` when the page shows any.
#}
{% extends "govuk/template.njk" %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{% block pageTitle %}{{ "Error: " if errors }}{{ title }} - URL shortener{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/assets/govuk-frontend.min.css">
{% endblock %}

{% block headIcons %}{% endblock %}

{% block header %}
  <header class="govuk-template__header">
    {{ govukServiceNavigation({
      serviceName: "URL shortener",
      serviceUrl: "/"
    }) }}
  </header>
{% endblock %}

{% block footer %}{% endblock %}

{% block bodyEnd %}
  <script type="module" nonce="{{ cspNonce }}">
    import { initAll } from '/assets/govuk-frontend.min.js'
    initAll()
  </script>
{% endblock %}
