{#
  A page that only says what went wrong. Takes `title` and `message`.
#}
{% extends "layout.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ title }}</h1>
      <p class="govuk-body">{{ message }}</p>
      <p class="govuk-body"><a class="govuk-link" href="/">Go to the home page</a></p>
    </div>
  </div>
{% endblock %}
