//
// Dev container configuration.
// https://aka.ms/devcontainer.json.
//

{
  "name": "TPXimpact",
  "runArgs": [
    "--name", "kieranpotts-tpximpact",
    // Share the host's network, so the ports that Docker Compose and
    // Testcontainers publish on the host are reachable on `localhost`.
    "--network=host"
  ],
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "USER_UID": "${localEnv:UID}",
      "USER_GID": "${localEnv:GID}"
    }
  },

  // Run the editor's server, terminals, and tasks as the non-root user that the
  // Dockerfile ends on, not as `root`. The project is bind-mounted from the
  // host, so anything written to it as `root` (build output, `node_modules`,
  // Git objects) would end up root-owned on the host and need `sudo` to clean
  // up. SSH and GPG are also fussy about the ownership of the keys and config
  // mounted below. The name `vscode` is the base image's built-in non-root user
  // (with UID 1000, which normally matches the host user). The mount targets
  // below, under `/home/vscode`, MUST be kept in step with this name.
  "remoteUser": "vscode",

  // The workspace folder is a Git worktree, one of possibly several siblings
  // under the project root, alongside the bare repo. Worktree links are
  // absolute host paths in both directions (Git doesn't support relative ones),
  // so we must bind-mount the project at a path that matches the host – ie.
  // `/home/<user>/projects/<name>` is mounted at `/home/<user>/projects/<name>`)
  // — and point workspaceFolder at the worktree subfolder within it.
  "workspaceFolder": "${localWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=${localWorkspaceFolder}/..,type=bind,consistency=cached",

  // Bind-mount the host's Git config into the container, live, so `user.name`,
  // `user.email`, etc. always match the host. `~/.ssh` is mounted read-only —
  // that's all that's need for `git push`/`pull` over SSH to authenticate.
  //
  // `~/.gnupg` is deliberately NOT mounted. The Dev Containers extension
  // forwards the host's `gpg-agent` into the container itself (and copies the
  // public keyring), so commits are signed by the host's agent, and passphrase
  // prompts appear in the host's pinentry. Mounting `~/.gnupg` defeats that:
  // `gpg` in the container then starts its own agent, whose curses pinentry
  // has no TTY to prompt on ("gpg: signing failed: Inappropriate ioctl for
  // device").
  //
  // Docker refuses to start the container if the source of a bind mount is
  // missing, and there's no way to mark a mount as optional. So, before the
  // container is created, `initializeCommand` runs on the host and creates any
  // of the mounted files and folders that don't exist yet. Those that already
  // exist are left untouched. The trade-off is that this leaves empty files in
  // the host's home directory, for anyone who doesn't use them. This assumes a
  // POSIX shell on the host; on Windows (outside WSL) it runs in `cmd`.
  "initializeCommand": "touch ~/.gitconfig ~/local.gitconfig ~/local.gitmessage ~/local.gitignore && mkdir -p -m 700 ~/.ssh",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/local.gitconfig,target=/home/vscode/local.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/local.gitmessage,target=/home/vscode/local.gitmessage,type=bind,readonly",
    "source=${localEnv:HOME}/local.gitignore,target=/home/vscode/local.gitignore,type=bind,readonly",
    // "source=${localEnv:HOME}/.gnupg,target=/home/vscode/.gnupg,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],

  // The Docker CLI and Compose, talking to the host's Docker daemon. Docker
  // Compose and Testcontainers start their containers there, as siblings of
  // this one.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },

  "containerEnv": {
    // Testcontainers' containers publish their ports on the host, which this
    // container shares the network of.
    "TESTCONTAINERS_HOST_OVERRIDE": "localhost"
  },

  // Install application dependencies.
  "postCreateCommand": "make install",

  // Install the Git hook declared in `.pre-commit-config.yaml`, which runs
  // `make lint` and `make test` before every commit. It runs on every start.
  "postStartCommand": "pre-commit install",

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      // Install these VS Code extensions in the container.
      // NOTE: Keep this list of extensions synchronized with `../.vscode/extensions.json`.
      "extensions": [
        "asciidoctor.asciidoctor-vscode",
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig",
        "mathiasfrohlich.kotlin",
        "ms-vscode.makefile-tools",
        "ms-playwright.playwright",
        "vscjava.vscode-gradle"
      ]
    }
  }
}
