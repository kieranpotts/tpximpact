#!/usr/bin/env bash

#
# Runs the automated test suite: the API service's unit and integration tests,
# and the web client's tests. The integration tests need Docker.
#
# The acceptance tests are separate. See `run/acceptance`.
#

# Exit immediately on error (-e), treat unset variables as errors (-u), and
# propagate failures through pipelines (-o pipefail).
set -euo pipefail

# Resolve the project root (parent of the run/ directory) and change into it.
# This ensures the script behaves the same regardless of where it's invoked
# from.
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

echo "==> tests/api-service"
(cd src/api-service && ./gradlew test integrationTest)

echo "==> tests/web-client"
(cd tests/web-client && npm test)
