#!/usr/bin/env bash

#
# Runs every check: the linters, then the automated test suite, then the
# acceptance tests against the whole system. Stops at the first failure.
#
# The acceptance tests start the system under Docker Compose, on the same ports
# as `run/up`, so stop any other running copy of the system first.
#

# Exit immediately on error (-e), treat unset variables as errors (-u), and
# propagate failures through pipelines (-o pipefail).
set -euo pipefail

# Resolve the project root (parent of the run/ directory) and change into it.
# This ensures the script behaves the same regardless of where it's invoked
# from.
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

./run/lint
./run/test
./run/acceptance
