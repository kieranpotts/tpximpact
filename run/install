#!/usr/bin/env bash

#
# Installs project dependencies: Gradle and the API service's dependencies,
# the three npm packages, and the browser the acceptance tests drive.
#
# Playwright's browser needs some system libraries. The devcontainer has them.
# In other environments, install them with `npx playwright install-deps chromium`
# from `tests/acceptance/`.
#

# Exit immediately on error (-e), treat unset variables as errors (-u), and
# propagate failures through pipelines (-o pipefail).
set -euo pipefail

# Resolve the project root (parent of the run/ directory) and change into it.
# This ensures the script behaves the same regardless of where it's invoked
# from.
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

echo "==> src/api-service"
(cd src/api-service && ./gradlew --quiet dependencies > /dev/null)

for package in src/web-client tests/web-client tests/acceptance; do
  echo "==> ${package}"
  (cd "${package}" && npm ci --no-audit --no-fund)
done

echo "==> Playwright browser"
(cd tests/acceptance && npx playwright install chromium)
