#
# An example of a `.env` file, for local overrides of the system's settings.
#
# To use it, copy it to `.env` and uncomment what you want to change. Docker
# Compose reads `.env` from the project root automatically. Variables set in
# the shell take precedence over it. `.env` is ignored by Git.
#
# See also: docs > design > concepts > configuration.
#

# The host port the web client is published on.
# WEB_PORT=3000

# The host port the API service is published on.
# API_PORT=8080

# The prefix of every short URL. It defaults to the API service's address on
# the host, ie. the default is http://localhost:${API_PORT}.
# PUBLIC_BASE_URL=http://localhost:8080

# The host ports `make acceptance` publishes the web client and API service on.
# They differ from the ports above, so the acceptance tests can run alongside a
# system started with `make up`. `WEB_PORT`, `API_PORT`, and `PUBLIC_BASE_URL`
# don't apply to acceptance runs.
# ACCEPTANCE_WEB_PORT=3001
# ACCEPTANCE_API_PORT=8081
